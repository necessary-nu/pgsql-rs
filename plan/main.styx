name libpg_query

source {
    url https://github.com/pganalyze/libpg_query
    ref 27112f8af5de70368319a12c346c2fb37cd74476
}

children (
    {
        id reference
        title "Reproduce the PostgreSQL 19.0 raw parser references"
        kind @build
        children (
            {
                id reference.import
                title "Verify and extract the PostgreSQL 19.0 release"
                implements {
                    rust ([spec:pgq:req:import.release] [spec:pgq:req:import.checksum] [spec:pgq:req:import.isolation])
                }
            }

            {
                id reference.probes
                title "Build stock and patched raw parser probes"
                implements {
                    rust ([spec:pgq:req:reference.overlay] [spec:pgq:req:reference.build])
                }
                deps (reference.import)
            }

            {
                id reference.corpus
                title "Compare both raw parsers with reviewed corpus results"
                implements {
                    rust ([spec:pgq:req:corpus.compare])
                }
                deps (reference.probes)
            }
        )
    }

    {
        id parser
        title "Port PostgreSQL raw parsing to Rust"
        kind @feat
        children (
            {
                id parser.lexer
                title "Scan SQL and apply PostgreSQL lookahead"
                implements {
                    rust (
                        [spec:pgq:req:lex.keywords]
                        [spec:pgq:req:lex.byte-spans]
                        [spec:pgq:req:lex.comments]
                        [spec:pgq:req:lex.quoted-values]
                        [spec:pgq:req:lex.numbers-and-parameters]
                        [spec:pgq:req:lex.parser-lookahead]
                        [spec:pgq:req:lex.unicode-escape]
                    )
                }
                deps (reference.corpus)
                log (
                    {
                        at 2026-11-19T17:43:59.415827439Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id parser.tables
                title "Generate Rust tables and identify changed grammar actions"
                implements {
                    rust ([spec:pgq:req:grammar.tables] [spec:pgq:req:grammar.action-inventory])
                }
                deps (reference.corpus)
                log (
                    {
                        at 2026-11-19T17:44:31.491037468Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id parser.nodes
                title "Represent raw PostgreSQL node fields and source locations"
                implements {
                    rust ([spec:pgq:req:tree.node-layout] [spec:pgq:req:tree.statement-spans] [spec:pgq:req:tree.node-locations])
                }
                deps (reference.corpus)
                log (
                    {
                        at 2026-11-19T17:44:44.87328253Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id parser.reduce
                title "Integrate raw statements and all parser start modes"
                implements {
                    rust (
                        [spec:pgq:req:grammar.raw-sql]
                        [spec:pgq:req:grammar.sql-families]
                        [spec:pgq:req:grammar.parse-modes]
                        [spec:pgq:req:grammar.overlay-differences]
                        [spec:pgq:req:grammar.runtime]
                    )
                }
                deps (parser.dml parser.utility parser.diagnostics)
            }

            {
                id parser.parity
                title "Verify Rust raw parsing against the PG19 regression corpus"
                kind @test
                implements {
                    rust ([spec:pgq:req:grammar.corpus-parity])
                }
                deps (parser.reduce reference.corpus)
                log (
                    {
                        at 2026-11-19T19:03:11.379652178Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "At 6df1fad the checked-in first-party Rust parser matched 32,974 of the 54,471 PG19 corpus cases in all measured fields. The remaining 21,497 reported a first unported action (231 distinct productions). All token streams and scanner errors matched, including those cases. The corpus runner reported no incorrect completed outcomes. Reproduce with the coverage command in tools/pg19/regress/README.md."
                    }

                    {
                        at 2026-11-19T19:08:45.499611606Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "At 3e13dee the first-party Rust parser matches 47,619 of 54,471 PostgreSQL 19 regression cases on raw trees or diagnostics and scanner output. The other 6,852 stop at 192 distinct first unported actions. All completed cases agree with the patched PG19 reference."
                    }

                    {
                        at 2026-11-19T19:15:59.420217018Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "The merged SQL implementation at 333e9f2 exactly matches 50,352 of the 54,471 PG19 regression cases. The remaining 4,119 stop at 129 distinct first unported actions. No completed SQL tree, diagnostic or scan differs."
                    }

                    {
                        at 2026-11-19T19:53:49.648421942Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Rust 1.100.0 release build at d6942c9 reproduced all 54,471 pinned PostgreSQL 19.0 outcomes, including 54,280 accepted raw trees, 191 errors, scanner records and six start modes. No first missing actions or mismatches. The independent ignored corpus test also verifies oracle hashes. Rebuilding stock and compatibility PostgreSQL from the pinned archive and running the clean reference suite passed in 224.94 seconds."
                    }
                )
            }

            {
                id parser.engine
                title "Run the shift/reduce engine and propagate semantic values"
                implements {
                    rust ([spec:pgq:req:grammar.reductions])
                }
                deps (parser.tables parser.nodes parser.lexer)
                log (
                    {
                        at 2026-11-19T17:56:23.357406575Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id parser.expressions
                title "Construct expressions with PostgreSQL precedence"
                implements {
                    rust ([spec:pgq:req:grammar.expression-binding])
                }
                deps (parser.engine)
                log (
                    {
                        at 2026-11-19T18:14:23.429189185Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Evaluated tamnd/rupg at f82a2478e8e98881df79153feba7423d848133cc (Apache-2.0). Its generator read patched PG19.0 gram.y and produced dispatch for all 3,490 SQL alternatives. A temporary prototype with our lexer and tables matched 8,393 trees and 192 errors across 16 PG19 regression files, plus 36 parse mode and option comparisons. That sample exercised at least 1,217 reductions. Integrating this approach requires a license choice and stack-bounded action dispatch and node conversion."
                    }

                    {
                        at 2026-11-19T18:29:47.607247352Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "The out-of-tree grammar-action prototype matched the patched PostgreSQL 19.0 reference on all 54,471 checked cases across six raw parse modes. The comparison covered complete native tree text with byte locations, parse diagnostics, scanner tokens and scanner diagnostics. There were 54,280 successful parses and 191 errors. The prototype uses an Apache-2.0 translator. Shipping it requires the licensing decision and production integration, including iterative tree teardown."
                    }

                    {
                        at 2026-11-19T18:30:29.88371388Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-11-19T18:38:58.498137613Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "First-party partial port of SELECT expression reductions and set-operation binding, driven by PostgreSQL 19.0 gram.y. The parser explicitly reports unsupported productions. Further expression and statement families remain open."
                    }
                )
            }

            {
                id parser.queries
                title "Construct SELECT and set-operation trees"
                implements {
                    rust ([spec:pgq:sem:grammar.query-actions])
                }
                deps (parser.expressions)
                log (
                    {
                        at 2026-11-19T19:20:42.522726686Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id parser.dml
                title "Construct INSERT, UPDATE, DELETE and MERGE trees"
                implements {
                    rust ([spec:pgq:sem:grammar.dml-actions])
                }
                deps (parser.queries)
                log (
                    {
                        at 2026-11-19T19:21:54.30462837Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id parser.utility
                title "Construct DDL, transaction and utility trees"
                implements {
                    rust ([spec:pgq:sem:grammar.utility-actions])
                }
                deps (parser.expressions)
                log (
                    {
                        at 2026-11-19T19:43:37.210502733Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id parser.diagnostics
                title "Report parse errors with per-call lexer settings"
                implements {
                    rust ([spec:pgq:req:grammar.diagnostics] [spec:pgq:req:grammar.string-settings])
                }
                deps (parser.engine)
                log (
                    {
                        at 2026-11-19T18:01:09.444473443Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }
        )
    }

    {
        id codec
        title "Serialize and read PG19 trees and tokens"
        kind @feat
        children (
            {
                id codec.json
                title "Encode raw trees using the PG19 JSON mapping"
                implements {
                    rust ([spec:pgq:req:codec.json-envelope] [spec:pgq:req:codec.json-fields])
                }
                deps (parser.nodes codec.schema)
                log (
                    {
                        at 2026-11-19T17:57:34.567435733Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id codec.protobuf
                title "Read and write PG19 node and token messages"
                implements {
                    rust (
                        [spec:pgq:req:lex.token-results]
                        [spec:pgq:req:tree.literal-variants]
                        [spec:pgq:req:codec.protobuf-schema]
                        [spec:pgq:req:codec.errors-and-depth]
                    )
                }
                deps (parser.nodes parser.lexer codec.schema)
                log (
                    {
                        at 2026-11-19T18:07:13.706820348Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id codec.schema
                title "Generate and pin the PG19 compatibility descriptor"
                implements {
                    rust ([spec:pgq:req:codec.schema-import])
                }
                deps (reference.corpus)
                log (
                    {
                        at 2026-11-19T17:44:49.676558592Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }
        )
    }

    {
        id operations
        title "Port SQL query operations"
        kind @feat
        children (
            {
                id operations.split-scanner
                title "Split statement spans using the scanner"
                implements {
                    rust ([spec:pgq:req:split.scanner])
                }
                deps (parser.lexer)
                log (
                    {
                        at 2026-11-19T17:54:43.895997252Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id operations.split-parser
                title "Split validated raw statements"
                implements {
                    rust ([spec:pgq:req:split.parser])
                }
                deps (parser.reduce)
            }

            {
                id operations.fingerprint
                title "Fingerprint SQL in the selected parse mode"
                implements {
                    rust ([spec:pgq:req:fingerprint.constants])
                }
                deps (parser.reduce operations.fingerprint-tree)
            }

            {
                id operations.utility
                title "Classify utility statements"
                implements {
                    rust ([spec:pgq:req:utility.classify] [spec:pgq:req:utility.sequence])
                }
                deps (parser.reduce)
            }

            {
                id operations.normalize
                title "Normalize SQL literals and utility statements"
                implements {
                    rust (
                        [spec:pgq:req:normalize.substitutions]
                        [spec:pgq:req:normalize.literal-spans]
                        [spec:pgq:req:normalize.grouping]
                        [spec:pgq:req:normalize.utility]
                    )
                }
                deps (operations.fingerprint operations.utility)
            }

            {
                id operations.deparse
                title "Render SQL from raw trees with formatting and comments"
                implements {
                    rust (
                        [spec:pgq:req:deparse.round-trip]
                        [spec:pgq:req:deparse.quoting]
                        [spec:pgq:req:deparse.pretty]
                        [spec:pgq:req:deparse.comments]
                    )
                }
                deps (parser.reduce operations.deparse-stream)
            }

            {
                id operations.deparse-protobuf
                title "Deparse protobuf trees"
                implements {
                    rust ([spec:pgq:req:deparse.protobuf])
                }
                deps (operations.deparse codec.protobuf)
            }

            {
                id operations.summary
                title "Summarize and truncate raw queries"
                implements {
                    rust (
                        [spec:pgq:req:summary.entities]
                        [spec:pgq:req:summary.cte-scope]
                        [spec:pgq:req:summary.nested-filters]
                        [spec:pgq:req:summary.truncation]
                        [spec:pgq:req:summary.protobuf]
                    )
                }
                deps (operations.deparse codec.protobuf)
            }

            {
                id operations.split-parity
                title "Check statement boundaries across both split APIs"
                kind @test
                implements {
                    rust ([spec:pgq:req:split.boundaries])
                }
                deps (operations.split-scanner operations.split-parser)
            }

            {
                id operations.fingerprint-tree
                title "Hash native PG19 raw trees with compatibility options"
                implements {
                    rust (
                        [spec:pgq:req:fingerprint.digest]
                        [spec:pgq:req:fingerprint.lists]
                        [spec:pgq:req:fingerprint.aliases]
                        [spec:pgq:req:fingerprint.relation-digits]
                    )
                }
                deps (parser.nodes)
                log (
                    {
                        at 2026-11-19T18:15:52.627518944Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id operations.deparse-stream
                title "Render an ordered stream of native raw statements"
                implements {
                    rust ([spec:pgq:req:deparse.stream])
                }
                deps (parser.nodes parser.lexer)
                log (
                    {
                        at 2026-11-19T18:33:22.0534088Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }
        )
    }

    {
        id plpgsql
        title "Port PL/pgSQL function parsing"
        kind @feat
        children (
            {
                id plpgsql.functions
                title "Parse routine bodies and expose PL/pgSQL results"
                implements {
                    rust (
                        [spec:pgq:req:plpgsql.routines]
                        [spec:pgq:req:plpgsql.datums]
                        [spec:pgq:req:plpgsql.body]
                        [spec:pgq:req:plpgsql.errors]
                    )
                }
                deps (parser.reduce)
            }
        )
    }

    {
        id delivery
        title "Verify the standalone Rust library"
        kind @test
        children (
            {
                id delivery.native
                title "Exercise every public operation without the C runtime"
                implements {
                    rust ([spec:pgq:req:api.native])
                }
                deps (
                    parser.parity
                    codec.json
                    operations.split-parity
                    operations.normalize
                    operations.deparse-protobuf
                    operations.summary
                    plpgsql.functions
                )
            }

            {
                id delivery.parser-performance
                title "Meet PostgreSQL 19 C parse and JSON latency on all three comparison workloads"
                kind @perf
                implements {
                    rust ([spec:pgq:req:grammar.parse-speed])
                }
                log (
                    {
                        at 2026-11-19T22:03:14.5926943Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-11-19T22:41:28.873496105Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "The byte-for-byte gate verified all 54,266 successful corpus inputs. Seven paired rounds after specializing native reductions and reusing parser scratch measured Rust/C of 1.77/0.97 (SELECT 1), 2.19/1.15 (aggregate join), and 1.92/1.18 (corpus), parse/parse plus JSON. Leave the latency requirement open until all six pass on the same run."
                    }

                    {
                        at 2026-11-19T23:22:51.657696921Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "All 54,471 reference cases matched. With a 1 KiB initial buffer for nonempty statement JSON, seven paired median Rust/C ratios were 1.216, 1.431 and 1.536 for raw SELECT 1, aggregate join and corpus. Parse plus JSON passed on all three at 0.713, 0.907 and 0.933. The 54,266 successful corpus outputs matched byte for byte. Per-type record pools and compact semantic handles both slowed raw parsing in paired trials. The raw-parse requirement remains open."
                    }

                    {
                        at 2026-11-19T23:39:06.080435306Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Final release verification matched every JSON byte on 54,266 successful upstream inputs. Over seven alternating rounds on CPU 15, median Rust/C was 1.166, 1.303 and 1.579 for raw SELECT 1, aggregate join and corpus, and 0.781, 0.717 and 1.116 for parse plus JSON. Corpus JSON varied from 0.933 on the earlier release run to 1.116 on this run. An experimental profile-guided build trained both compilers on the same 12,396 separate valid PostgreSQL extension queries. On the held-out workloads the ratios were 0.837, 1.234 and 1.591 for raw parsing and 0.536, 1.031 and 0.910 for parse plus JSON. Keep the six-median release gate open."
                    }

                    {
                        at 2026-11-19T23:57:44.950218285Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Profiled raw parsing and result destruction in both optimized implementations on SELECT 1, the aggregate join and all 54,266 successful regression inputs. The join spends 14,403 extra Rust instructions in parsing and tree construction and 11,676 in result cleanup. The corpus averages 3,602 extra during parsing and construction and 2,279 during cleanup. Column reference and dotted field reductions are the largest join actions. C reuses its memory context, while Rust allocates six blocks on SELECT 1, 90 on the join and 20.38 on the corpus. Cycle samples, instruction counts, allocation sites and reproduction commands are in tools/pg19/bench/raw-profile.md."
                    }

                    {
                        at 2026-11-20T00:38:12.144289052Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Forward the first indirection element through the grammar so qualified columns construct their final field vector in one allocation. The join now uses one realloc per parse instead of eight and requests 3,803 bytes instead of 4,643. Raw retired instructions fell from 68,752 to 64,390 on the join and 17,784 to 17,583 on the corpus. SELECT 1 moved from 4,887 to 4,907. All 54,471 reference results and every successful benchmark JSON byte matched. The raw latency target remains open."
                    }

                    {
                        at 2026-11-20T00:58:35.952558065Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Scan common words using the pinned Flex transitions, and recognize short keywords using the generated PostgreSQL catalog. Raw Rust retired 4,574 instructions on SELECT 1, 59,260 on the aggregate join and 16,072 per successful corpus input, down from 4,907, 64,390 and 17,583. Core and grammar token streams matched on 97,356 inputs with both string settings, and all 54,471 parser outcomes matched the PG19 reference. Seven paired release rounds on CPU 13 gave raw Rust/C medians of 0.577/0.521, 13.048/10.422 and 3.922/2.336 microseconds respectively. All three raw latency targets remain open."
                    }

                    {
                        at 2026-11-20T01:22:57.485384944Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Bison now supplies the lookahead sets for reducing omitted trailing SELECT and aggregate clauses in one action. On seven paired release rounds pinned to CPU 17, raw Rust/C medians were 0.350/0.430 microseconds for SELECT 1, 6.979/6.038 for the aggregate join and 2.722/1.888 per corpus query. SELECT 1 meets the target. The join and corpus remain 15.6% and 44.2% above C. All 54,471 pinned outcomes matched, all benchmark JSON bytes matched, and 72 extra inputs agreed with C, including 28 stack-limit diagnostics. Rust retired 3,441, 57,271 and 15,532 instructions per input respectively."
                    }

                    {
                        at 2026-11-20T02:19:26.200582073Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "The parser now finishes a statement list directly when the pinned grammar proves its remaining reductions. All 54,471 reference outcomes matched, as did 72 stack and clause edge cases and the exact JSON bytes for all timing inputs. Across seven paired raw runs the corpus improved in every pair against the previous Rust binary, with a 7.7% median reduction, while the join's paired median rose 1.2%. Seven separate rounds against optimized C on CPU 31 gave Rust/C raw medians of 0.663/0.858 microseconds for SELECT 1, 13.058/10.275 for the aggregate join and 5.281/3.421 per corpus input. Only SELECT 1 meets the raw latency requirement. Hardware samples on the preceding release attributed the full join cycle gap and 46% of the corpus cycle gap to releasing the result."
                    }

                    {
                        at 2026-11-20T02:45:07.21222991Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "The generator now uses indexed destination and action tables for 32 nonterminals in the pinned PostgreSQL grammar. All 54,471 reference outcomes and 72 additional cases matched. The release gate verified exact JSON bytes for every input. On seven paired rounds on CPU 3, median raw Rust/C times were 0.365/0.472 microseconds for SELECT 1, 6.790/6.039 for the aggregate join, and 2.442/1.918 per corpus input. The join is 12.4% slower and the corpus is 27.4% slower. A separate fully materialized, per-query arena experiment reclaimed the tree in bulk and measured 5.945/6.220 microseconds on the join and 2.195/2.122 on the corpus. Those numbers apply to the experiment. The public parser still returns independently owned nodes."
                    }
                )
            }
        )
    }
)
