platforms (
    {
        platform "rust"
        files ("Cargo.toml" "Cargo.lock" "crates/**/*.rs" "crates/**/Cargo.toml")
        checks {
            format {cmd "cargo fmt --all -- --check", fix "cargo fmt --all"}
            lint {cmd "cargo clippy --workspace --all-targets -- -D warnings"}
            test {cmd "cargo test --workspace"}
        }
    }
    {
        platform "pgsql-reference"
        files ("tools/pg19/**/*" "crates/pgsql-reference/**/*" "protobuf/pg19/**/*")
        checks {
            test {cmd "python3 tools/pg19/tests/check-fixtures.py && cargo test -p pgsql-reference"}
        }
    }
)
commit {type-prefix "required"}
adoption {scope "porting"}
quality {
    // Cargo integration tests in tests/ cover the library in src/.
    test-footprint {scope "crate"}
    exempt-paths ("crates/pgsql-lexer/data/catalog.rs")
}
